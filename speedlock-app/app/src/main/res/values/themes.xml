<resources>
    <!-- Base application theme using Material 3 with Fluent-inspired dark/light adaptations -->
    <style name="Theme.SpeedLock" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Navigation Bar & Status Bar -->
        <item name="android:statusBarColor">@color/window_background</item>
        <item name="android:navigationBarColor">@color/nav_bar_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>
